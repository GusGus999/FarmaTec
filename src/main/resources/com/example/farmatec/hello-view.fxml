<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.farmatec.controller.ProductoController"
      spacing="10"
      alignment="CENTER"
      prefWidth="400"
      prefHeight="400">

    <Label text="Registro de productos"/>

    <TextField fx:id="campoNombre" promptText="Nombre del producto"/>
    <TextField fx:id="campoPrecio" promptText="Precio"/>

    <Button text="Guardar producto" onAction="#guardarProducto"/>

    <ListView fx:id="listaProductos" prefHeight="200"/>

    <Label fx:id="mensaje"/>

</VBox>